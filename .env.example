# ─── Supabase ──────────────────────────────────────────────────────────────
# Panel de Supabase → Project Settings → API Keys.
# En local, `npx supabase status` muestra estos valores.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave publicable (sb_publishable_...) o la "anon key" antigua. Es pública: va al navegador.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave secreta (sb_secret_...) o la "service_role" antigua.
# SOLO la usa el script de datos de ejemplo (npm run seed). NUNCA la pongas con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# ─── App ───────────────────────────────────────────────────────────────────
# URL pública de la app (se usa para los enlaces de confirmación y el login con Google).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Generador de anuncios ────────────────────────────────────────────────
# "plantillas" (por defecto, sin costo) o "ia" (requiere ANUNCIOS_IA_API_KEY; aún no implementado).
ANUNCIOS_PROVEEDOR=plantillas
ANUNCIOS_IA_API_KEY=

# ─── Pagos ─────────────────────────────────────────────────────────────────
# Proveedor: "paypal" (PayPal o tarjeta vía PayPal) o "simulado" (solo desarrollo/demos, no cobra).
# Si se deja vacío: PayPal si hay credenciales; si no, el simulado fuera de producción.
PAGOS_PROVEEDOR=
# Permitir el simulador en producción (para demos). Nunca en una tienda real.
PAGOS_PERMITIR_SIMULADO=false

# PayPal: developer.paypal.com → Apps & Credentials. PayPal cobra en US$ (no opera en soles).
PAYPAL_ENTORNO=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# developer.paypal.com → tu app → Webhooks → URL https://TU-DOMINIO/api/pagos/paypal/webhook
PAYPAL_WEBHOOK_ID=
# IDs de los planes (los imprime: npx tsx scripts/paypal-crear-planes.ts)
PAYPAL_PLAN_BASICO=
PAYPAL_PLAN_PRO=
PAYPAL_PLAN_CONCESIONARIO=
